# ---- Convex ----
# Set automatically by `npx convex dev`. The web app reads NEXT_PUBLIC_CONVEX_URL (see apps/web/.env.example).
CONVEX_DEPLOYMENT=

# ---- Transcription compute (Modal) ----
# Set these on the CONVEX deployment (npx convex env set ...). MODAL_TRANSCRIBE_URL is the
# URL printed by `modal deploy modal/transcribe.py`; MODAL_AUTH_TOKEN is a shared bearer
# token Convex sends and Modal verifies.
MODAL_TRANSCRIBE_URL=
MODAL_AUTH_TOKEN=

# Shared secret so the Modal job can authenticate when writing transcripts back to the
# Convex httpAction callback. Lives on both Convex and the Modal secret.
CONVEX_CALLBACK_SECRET=
# Base URL of your Convex HTTP actions endpoint (e.g. https://<deployment>.convex.site).
# Set inside the Modal secret (see modal/README.md).
CONVEX_HTTP_URL=

# ---- Modal-side secret (set via `modal secret create audio-unpack ...`, not here) ----
# HF_TOKEN — Hugging Face token; required only for the diarization mode (gated pyannote 3.1).
# CONVEX_HTTP_URL, CONVEX_CALLBACK_SECRET, MODAL_AUTH_TOKEN — also live in that Modal secret.

# ---- Summaries (Vercel AI SDK; set on the Convex deployment) ----
# https://console.anthropic.com  — default, higher-quality summaries
ANTHROPIC_API_KEY=
# https://console.groq.com/keys  — optional free alternative for summaries
GROQ_API_KEY=
